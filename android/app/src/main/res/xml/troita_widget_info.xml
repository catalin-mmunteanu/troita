<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is a backstop only. The widget is refreshed when the
     app opens and by a just-after-midnight alarm; this hourly update covers a
     missed alarm. 30 minutes is the floor Android allows. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/troita_widget"
    android:previewLayout="@layout/troita_widget"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
