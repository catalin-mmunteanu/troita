<?xml version="1.0" encoding="utf-8"?>
<!-- The app's paper colour and hairline border, so the widget looks like a
     piece of the calendar rather than a generic system card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FCFAF2" />
    <stroke android:width="1dp" android:color="#EADFC9" />
    <corners android:radius="20dp" />
</shape>
