!.vscode/launch.json
!.vscode/extensions.json
*.swp
*~

# ------------------------------------------------------------------------- OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------------------------------------------------- Secrets
.env
.env.*
!.env.example
*.pem
secrets.json
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------ Scratch
*.log
coverage/
test/failures/
/scratch/
/tmp/
