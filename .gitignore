# ---------------------------------------------------------------- Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.dart.js
*.info.json
*.js_
*.js.deps
*.js.map
doc/api/

# pubspec.lock IS committed. This is an application, not a package — pinning
# resolved versions is what makes a build reproducible across machines and CI.
!pubspec.lock

# --------------------------------------------------------------------- Android
android/.gradle/
android/captures/
android/.cxx/
android/app/debug/
android/app/profile/
android/app/release/
.gradle/

# Machine-specific SDK paths. Regenerated by `flutter pub get`, and committing
# it breaks every other developer's build with your paths.
android/local.properties

# The Gradle wrapper jar must NOT be ignored — a clone without it cannot build.
# Listed explicitly because blanket *.jar rules are a common mistake.
!android/gradle/wrapper/gradle-wrapper.jar

# ------------------------------------------------------------------- Signing
# Never commit these. The release keystore is the identity of the app on Play;
# losing control of it means you cannot ship updates, and leaking it means
# someone else can.
*.jks
*.keystore
key.properties
android/key.properties
**/keystore.properties

# ------------------------------------------------------------------------ iOS
# Not built yet, but these are the ones that bite when it is.
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/App.framework
ios/Flutter/ephemeral/
**/*.mobileprovision
**/*.p12
**/*.p8

# -------------------------------------------------------------- Seed pipeline
# The Overpass response cache — can be tens of megabytes and is reproducible.
tool/.overpass-cache.json

# SQLite side-car files. These appear next to the seed database when a build is
# interrupted and must never be shipped inside the APK; a stray file under
# assets/ or res/ is a build failure or, worse, a corrupted read.
*.db-journal
*.db-wal
*.db-shm

# NOTE: android/app/src/main/assets/seed/churches.db and version.txt ARE
# committed. They are technically build artifacts, but regenerating them needs
# network access to Overpass, and the app will not run without them — so a
# fresh clone must be able to build offline. Regenerate with:
#   python3 tool/build_seed.py --area bucuresti-ilfov \
#       --out android/app/src/main/assets/seed/churches.db
# If the dataset ever grows past a few MB, revisit this and move it to a release
# asset or Git LFS instead.

# ---------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

